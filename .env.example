# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key (safe to expose in the Next.js client; used for read-only queries)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (KEEP SECRET — server-side / scraper writes only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Tee-time alerts (optional) ---
# Sign up at https://resend.com (free 100 emails/day), copy the API key.
RESEND_API_KEY=
# Where to send the digest emails.
ALERT_EMAIL=
# Override criteria (defaults shown):
# ALERT_MIN_PLAYERS=2
# ALERT_AFTER_HOUR_PT=5      # earliest hour (24h, PT) — 5 = 5 AM
# ALERT_BEFORE_HOUR_PT=10    # latest hour (exclusive) — 10 = before 10 AM
# ALERT_WEEKDAYS=0,6         # 0=Sun, 6=Sat
# ALERT_HOLES=18
# ALERT_COOLDOWN_MIN=240     # re-alert cooldown per slot
# ALERT_MAX_PRICE_CENTS=10000   # skip slots > $100 (in cents). Unset = no cap.
# ALERT_EXCLUDE_SLUGS=        # comma-separated slugs to skip in alerts;
                              # also set "alertExclude": true per course in courses.json

# --- Subscriber emails (scrapers/send-emails.ts) ---
# Bare address on a domain verified in Resend (not @resend.dev). Shown as
# "Daniel at SD Tee Times <EMAIL_FROM>".
EMAIL_FROM=
# Where replies go.
EMAIL_REPLY_TO=
# Optional donate link (Ko-fi, Buy Me a Coffee, Stripe Payment Link). The
# donate line only appears when this is set.
DONATE_URL=
# Optional mailing address for the email footer (CAN-SPAM). Owner's call:
# a PO box or virtual mailbox is fine. Only shown when set.
EMAIL_POSTAL_ADDRESS=
# Must be exactly "true" for --mode=send to send anything.
EMAILS_ENABLED=
# Optional caps and tuning (defaults shown):
# EMAIL_DAILY_CAP=80
# EMAIL_MONTHLY_CAP=2500
# EMAIL_MAX_PICK_PRICE_CENTS=20000
