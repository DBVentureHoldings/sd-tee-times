# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key (safe to expose in the Next.js client; used for read-only queries)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (KEEP SECRET — server-side / scraper writes only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Tee-time alerts (optional) ---
# Sign up at https://resend.com (free 100 emails/day), copy the API key.
RESEND_API_KEY=
# Where to send the digest emails.
ALERT_EMAIL=
# Override criteria (defaults shown):
# ALERT_MIN_PLAYERS=2
# ALERT_AFTER_HOUR_PT=5      # earliest hour (24h, PT) — 5 = 5 AM
# ALERT_BEFORE_HOUR_PT=10    # latest hour (exclusive) — 10 = before 10 AM
# ALERT_WEEKDAYS=0,6         # 0=Sun, 6=Sat
# ALERT_HOLES=18
# ALERT_COOLDOWN_MIN=240     # re-alert cooldown per slot
# ALERT_MAX_PRICE_CENTS=10000   # skip slots > $100 (in cents). Unset = no cap.
# ALERT_EXCLUDE_SLUGS=        # comma-separated slugs to skip in alerts;
                              # also set "alertExclude": true per course in courses.json
