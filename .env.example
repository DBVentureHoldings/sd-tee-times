# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key (safe to expose in the Next.js client; used for read-only queries)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (KEEP SECRET — server-side / scraper writes only)
SUPABASE_SERVICE_ROLE_KEY=
